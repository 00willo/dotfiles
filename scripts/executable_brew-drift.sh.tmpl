#!/bin/bash
set -euo pipefail

{{ $remote := output "sh" "-c" (printf "git -C %s remote get-url origin 2>/dev/null || true" (.chezmoi.sourceDir | quote)) | trim -}}
{{ $repo := $remote | replace "git@github.com:" "https://github.com/" | trimSuffix ".git" | default "(unknown remote)" -}}
# MANAGED BY CHEZMOI -- do not edit this file; changes are lost on `chezmoi apply`.
# Repo:   {{ $repo }}
# Source: {{ .chezmoi.sourceFile }}
# Edit with: chezmoi edit ~/scripts/brew-drift.sh

# Report drift between what is installed and what .chezmoidata declares.
# Read-only: never installs, upgrades or removes anything.
#
# "Explicit" means Homebrew's install receipt says installed_on_request --
# you asked for it, rather than it arriving as someone else's dependency.
# Dependencies are ignored on purpose: they are brew's business, not the
# dotfiles'. Note `brew leaves` is the wrong tool here, as it hides an
# explicit package as soon as something else depends on it.

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cat >"$tmp/Brewfile" <<EOF
{{ template "darwin-brewfile" . -}}
EOF

# Strip any tap prefix so "jundot/omlx/omlx" matches brew's reported "omlx".
grep -oE '^brew "[^"]+"' "$tmp/Brewfile" | sed 's/brew "//;s/"//;s|.*/||' | sort -u >"$tmp/declared_brews"
grep -oE '^cask "[^"]+"' "$tmp/Brewfile" | sed 's/cask "//;s/"//' | sort -u >"$tmp/declared_casks"

brew list --installed-on-request | sed 's|.*/||' | sort -u >"$tmp/explicit_brews"
brew list --cask | sort -u >"$tmp/installed_casks"

comm -23 "$tmp/explicit_brews" "$tmp/declared_brews" >"$tmp/undeclared_brews"
comm -23 "$tmp/installed_casks" "$tmp/declared_casks" >"$tmp/undeclared_casks"
comm -13 "$tmp/explicit_brews" "$tmp/declared_brews" >"$tmp/missing_brews"
comm -13 "$tmp/installed_casks" "$tmp/declared_casks" >"$tmp/missing_casks"

status=0
report() {
    [[ -s "$2" ]] || return 0
    echo "$1"
    sed 's/^/  /' "$2"
    echo
    status=1
}

report "Installed explicitly but NOT declared (add to .chezmoidata, or uninstall):" "$tmp/undeclared_brews"
report "Casks installed but NOT declared (add to .chezmoidata, or uninstall):" "$tmp/undeclared_casks"
report "Declared but not installed on request (chezmoi apply will install):" "$tmp/missing_brews"
report "Declared casks not installed (chezmoi apply will install):" "$tmp/missing_casks"

if [[ $status -eq 0 ]]; then
    echo "No drift: installed packages match .chezmoidata."
fi

exit $status
