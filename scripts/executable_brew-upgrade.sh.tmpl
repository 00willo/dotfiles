#!/usr/bin/env bash
set -euo pipefail

{{ $remote := output "sh" "-c" (printf "git -C %s remote get-url origin 2>/dev/null || true" (.chezmoi.sourceDir | quote)) | trim -}}
{{ $repo := $remote | replace "git@github.com:" "https://github.com/" | trimSuffix ".git" | default "(unknown remote)" -}}
# MANAGED BY CHEZMOI -- do not edit this file; changes are lost on `chezmoi apply`.
# Repo:   {{ $repo }}
# Source: {{ .chezmoi.sourceFile }}
# Edit with: chezmoi edit ~/scripts/brew-upgrade.sh

# Upgrade the packages declared in chezmoi's package data, and nothing else.
# Deliberately not run by `chezmoi apply` -- adding a package should never
# upgrade unrelated ones. Run this by hand when you want to move versions.
#
# Usage:
#   brew-upgrade.sh            # upgrade declared packages
#   brew-upgrade.sh --dry-run  # report what would be upgraded, change nothing
#
# See also brew-drift.sh, which reports declared-vs-installed differences.

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cat >"$tmp/Brewfile" <<EOF
{{ template "darwin-brewfile" . -}}
EOF

if [[ "${1:-}" == "--dry-run" ]]; then
    # Strip tap prefixes so "jundot/omlx/omlx" matches brew's reported "omlx".
    grep -oE '^(brew|cask) "[^"]+"' "$tmp/Brewfile" |
        sed 's/^[a-z]* "//;s/"//;s|.*/||' | sort -u >"$tmp/declared"

    brew outdated --formula --quiet | sed 's|.*/||' | sort -u >"$tmp/outdated"
    brew outdated --cask --greedy --quiet | sort -u >>"$tmp/outdated"
    sort -u -o "$tmp/outdated" "$tmp/outdated"

    echo "Would upgrade (outdated and declared):"
    comm -12 "$tmp/outdated" "$tmp/declared" | sed 's/^/  /'
    echo
    echo "Not targeted (outdated, undeclared; a dep may still move if needed):"
    comm -23 "$tmp/outdated" "$tmp/declared" | sed 's/^/  /'
    exit 0
fi

brew update

brew bundle upgrade --file="$tmp/Brewfile"
